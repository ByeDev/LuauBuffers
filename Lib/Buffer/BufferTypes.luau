--!strict
export type bufferReader = {
    new: (inputBuffer: buffer?) -> bufferReader,
	readi8: (self: bufferReader) -> number,
	readu8: (self: bufferReader) -> number,
	readi16: (self: bufferReader) -> number,
	readu16: (self: bufferReader) -> number,
	readf16: (self: bufferReader) -> number,
	readu24: (self: bufferReader) -> number,
	readi32: (self: bufferReader) -> number,
	readu32: (self: bufferReader) -> number,
	readf32: (self: bufferReader) -> number,
	readf64: (self: bufferReader) -> number,
	readV2: (self: bufferReader) -> Vector2,
	readV3: (self: bufferReader) -> Vector3,
	readCFrame: (self: bufferReader) -> CFrame,
	readString: (self: bufferReader) -> string,
	readStringArray: (self: bufferReader) -> {string},
	readDict: (self: bufferReader, keyType: number, valueType: number) -> {[any]: any},
	readStructs: (self: bufferReader, schema: any) -> any,
	readVarietyInt: (self: bufferReader) -> number,
	readFloatIntArray: <T>(self: bufferReader) -> {T},
	setBuffer: (self: bufferReader, newBuffer: buffer) -> (),
}

export type bufferWriter = {
	new: (size: number?) -> bufferWriter,
	writei8: (self: bufferWriter, value: number) -> (),
	writeu8: (self: bufferWriter, value: number) -> (),
	writei16: (self: bufferWriter, value: number) -> (),
	writeu16: (self: bufferWriter, value: number) -> (),
	writef16: (self: bufferWriter, value: number) -> (),
	writeu24: (self: bufferWriter, value: number) -> (),
	writei32: (self: bufferWriter, value: number) -> (),
	writeu32: (self: bufferWriter, value: number) -> (),
	writef32: (self: bufferWriter, value: number) -> (),
	writef64: (self: bufferWriter, value: number) -> (),
	writeV2: (self: bufferWriter, value: Vector2) -> (),
	writeV3: (self: bufferWriter, value: Vector3) -> (),
	writeCFrame: (self: bufferWriter, value: CFrame) -> (),
	writeString: (self: bufferWriter, value: string) -> (),
	writeStringArray: (self: bufferWriter, array: {string}) -> (),
	writeDict: (self: bufferWriter, keyType: number, valueType: number, dict: {[any]: any}) -> (),
	writeStructs: (self: bufferWriter, schema: any, data: any) -> (),
	writeVarietyInt: (self: bufferWriter, integer: number) -> (),
	writeFloatIntArray: <T>(self: bufferWriter, array: {T}) -> (),
	createBuffer: (self: bufferWriter) -> buffer,
	clear: (self: bufferWriter) -> (),
}

return {}
